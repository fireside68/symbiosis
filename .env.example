# Copy to .env and fill in for your environment. Loaded automatically via
# python-dotenv (config/settings.py); real environment variables always
# win over whatever's in here. Every var below has a dev-safe default if
# left unset — see config/settings.py.

# SECRET_KEY=dev-only-not-secret
# DEBUG=1
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com

# Postgres — matches docker-compose.yaml's postgres service. Omit for the
# zero-setup SQLite default.
# DATABASE_URL=postgres://symbiosis:symbiosis@localhost:5433/symbiosis

# Redis — matches docker-compose.yaml's redis service. Omit to run Celery
# tasks eagerly in-process and Channels on an in-memory layer (single
# process only — fine for local dev, not for a separate worker process).
# REDIS_URL=redis://localhost:6379/0
